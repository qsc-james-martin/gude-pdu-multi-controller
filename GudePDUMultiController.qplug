-- Gude PDU Multi Controller
-- Q-SYS plugin that groups several Gude Expert Power Control plugin instances into one panel.
--  * Select PDUs and switch them on/off
--  * Press-and-hold All On / All Off with a configurable PDU scope ("1-9", "1-4, 6-9", "all except 10" ...)
--  * Per-PDU on/off outlet lists (include or exclude outlets)
--  * Aggregated power / current / energy / voltage (from InletX N or summed OutletX N) plus a combined status
--
-- Requirements: each Gude PDU plugin must have Script Access enabled (Script or All).
-- Gude components are found by plugin GUID 155aca43-286f-4b5d-8063-a567999c55e3.

PluginInfo = {
  Name = "Gude~PDU Multi Controller",
  Version = "1.0.10",
  Id = "9f79b1c0-43f7-485a-9f80-bc6607cafaec",
  Author = "James Martin",
  Description = "Groups multiple Gude PDU plugins: selective on/off, hold-to-switch all, outlet filters and aggregated metering/status.",
  ShowDebug = true
}

function GetColor(props)
  return { 0, 94, 168 }
end

function GetPrettyName(props)
  return "Gude PDU Multi Controller  v" .. PluginInfo.Version
end

--------------------------------------------------------------------
-- Properties
--------------------------------------------------------------------
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "PDU Count",
    Type = "integer",
    Min = 1,
    Max = 32,
    Value = 4
  })
  table.insert(props, {
    Name = "Metering",
    Type = "enum",
    Choices = { "Off", "On" },
    Value = "Off"
  })
  table.insert(props, {
    Name = "Debug Print",
    Type = "enum",
    Choices = { "No", "Yes" },
    Value = "No"
  })
  return props
end

function RectifyProperties(props)
  return props
end

--------------------------------------------------------------------
-- Controls
--------------------------------------------------------------------
function GetControls(props)
  local n = props["PDU Count"].Value
  local metering = props["Metering"].Value == "On"
  local ctls = {}

  local function add(t)
    t.UserPin = true
    t.PinStyle = t.PinStyle or "Both"
    t.Count = t.Count or 1
    table.insert(ctls, t)
  end

  -- Combined status / totals
  add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })
  add({ Name = "PDUsOnline", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  add({ Name = "OutletsOn", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  if metering then
    add({ Name = "TotalPower", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
    add({ Name = "TotalCurrent", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
    add({ Name = "TotalEnergy", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
    add({ Name = "AvgVoltage", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  end
  add({ Name = "LastAction", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })

  -- Selection control
  add({ Name = "Select", ControlType = "Button", ButtonType = "Toggle", Count = n })
  add({ Name = "SelectAll", ControlType = "Button", ButtonType = "Trigger" })
  add({ Name = "SelectNone", ControlType = "Button", ButtonType = "Trigger" })
  add({ Name = "On", ControlType = "Button", ButtonType = "Trigger" })
  add({ Name = "Off", ControlType = "Button", ButtonType = "Trigger" })

  -- Hold-to-switch all
  add({ Name = "AllOn", ControlType = "Button", ButtonType = "Momentary" })
  add({ Name = "AllOff", ControlType = "Button", ButtonType = "Momentary" })
  add({ Name = "HoldProgress", ControlType = "Indicator", IndicatorType = "Meter", Min = 0, Max = 1, PinStyle = "Output" })
  add({ Name = "AllScopeResult", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })

  -- Per-PDU feedback
  add({ Name = "RowOn", ControlType = "Button", ButtonType = "Trigger", Count = n })
  add({ Name = "RowOff", ControlType = "Button", ButtonType = "Trigger", Count = n })
  add({ Name = "RowPower", ControlType = "Button", ButtonType = "Toggle", Count = n })
  add({ Name = "PduLed", ControlType = "Indicator", IndicatorType = "Led", Count = n, PinStyle = "Output" })
  add({ Name = "PduState", ControlType = "Indicator", IndicatorType = "Text", Count = n, PinStyle = "Output" })
  if metering then
    add({ Name = "PduPower", ControlType = "Indicator", IndicatorType = "Text", Count = n, PinStyle = "Output" })
    add({ Name = "PduCurrent", ControlType = "Indicator", IndicatorType = "Text", Count = n, PinStyle = "Output" })
    add({ Name = "PduEnergy", ControlType = "Indicator", IndicatorType = "Text", Count = n, PinStyle = "Output" })
  end
  add({ Name = "PduStatus", ControlType = "Indicator", IndicatorType = "Status", Count = n, PinStyle = "Output" })

  -- Setup: per-PDU
  add({ Name = "ComponentName", ControlType = "Text", Count = n })
  add({ Name = "PduName", ControlType = "Text", Count = n })
  add({ Name = "OnOutlets", ControlType = "Text", Count = n })
  add({ Name = "OffOutlets", ControlType = "Text", Count = n })
  add({ Name = "Resolved", ControlType = "Indicator", IndicatorType = "Text", Count = n, PinStyle = "Output" })

  -- Setup: global
  add({ Name = "AllScope", ControlType = "Text", DefaultValue = "all" })
  add({ Name = "DefaultOnOutlets", ControlType = "Text", DefaultValue = "all" })
  add({ Name = "DefaultOffOutlets", ControlType = "Text", DefaultValue = "all" })
  add({ Name = "HoldTime", ControlType = "Knob", ControlUnit = "Seconds", Min = 0, Max = 10, DefaultValue = 2 })
  add({ Name = "Stagger", ControlType = "Knob", ControlUnit = "Seconds", Min = 0, Max = 5, DefaultValue = 0.1 })
  add({ Name = "PollInterval", ControlType = "Knob", ControlUnit = "Seconds", Min = 1, Max = 60, DefaultValue = 3 })
  add({ Name = "AutoClear", ControlType = "Button", ButtonType = "Toggle", DefaultValue = false })

  -- Setup: metering
  if metering then
    add({ Name = "MeterSource", ControlType = "Text", DefaultValue = "Inlets" })
  end

  return ctls
end

--------------------------------------------------------------------
-- Layout
--------------------------------------------------------------------
local PageNames = { "Control", "Setup" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local n = props["PDU Count"].Value
  local metering = props["Metering"].Value == "On"
  local page = PageNames[props["page_index"].Value]
  local W = 640

  local function key(name, i)
    if n > 1 then return name .. " " .. i end
    return name
  end

  local function label(text, x, y, w, h, align, size)
    table.insert(graphics, {
      Type = "Text", Text = text, Position = { x, y }, Size = { w, h or 16 },
      FontSize = size or 11, HTextAlign = align or "Right"
    })
  end

  local function group(text, x, y, w, h)
    table.insert(graphics, {
      Type = "GroupBox", Text = text, Position = { x, y }, Size = { w, h },
      HTextAlign = "Left", StrokeWidth = 1, CornerRadius = 6, Fill = { 242, 242, 242 }
    })
  end

  local function text(name, x, y, w, h, readOnly)
    layout[name] = {
      Style = "Text", Position = { x, y }, Size = { w, h or 16 }, FontSize = 11,
      HTextAlign = "Center", IsReadOnly = readOnly or false
    }
  end

  local function button(name, legend, x, y, w, h, color)
    layout[name] = {
      Style = "Button", Legend = legend, Position = { x, y }, Size = { w, h or 16 },
      FontSize = 9, CornerRadius = 4, Color = color
    }
  end

  local STATS = {
    { "PDUsOnline", "PDUs Online", 66, 48 },
    { "OutletsOn", "Outlets On", 60, 56 },
  }
  if metering then
    table.insert(STATS, { "TotalPower", "Total Power", 66, 64 })
    table.insert(STATS, { "TotalCurrent", "Total Current", 76, 56 })
    table.insert(STATS, { "TotalEnergy", "Total Energy", 72, 76 })
    table.insert(STATS, { "AvgVoltage", "Avg Voltage", 66, 56 })
  end
  local ON_LEGEND, OFF_LEGEND = "On", "Off"
  local HELP = "Select PDUs then press On / Off.  Hold All On / All Off for the hold time (Setup page)."
  local ROWS_TITLE, ROW_NAME, LED, STATUS_TITLE, STATUS_CTL = "PDUs", "PDU", "PduLed", "PDU Status", "PduStatus"
  local COLS = {
    { "PduState", "State", 96 },
    { "PduPower", "Power", 64, metering = true },
    { "PduCurrent", "Current", 56, metering = true },
    { "PduEnergy", "Energy", 76, metering = true },
  }
  local ASSIGN_TITLE = "PDU Assignment  (blank outlet fields use the defaults below)"
  local NAME_CTL, ON_FIELD, OFF_FIELD = "PduName", { "OnOutlets", "On Outlets" }, { "OffOutlets", "Off Outlets" }
  local SCOPE_LABEL = "All On / All Off PDUs"
  local SCOPE_HINT = "e.g.  all  |  1-9  |  1-4, 6-9  |  all except 10  |  !5"
  local DEFAULT_ON, DEFAULT_OFF = { "DefaultOnOutlets", "Default On Outlets" }, { "DefaultOffOutlets", "Default Off Outlets" }
  local FIELD_HINT = "Outlets: all  |  1-6  |  all except 1  |  !1, !8  |  none"
  local OVERRIDE_HINT, EXTRA_HINT = "Per-PDU fields above override these.", nil
  local STAGGER_LABEL = "PDU Stagger (s)"
  local METER_SOURCE = "Inlets: inlet totals  |  Outlets: sum of outlets (no energy)"

  if page == "Control" then
    -- Combined: status row, then inline "label value" stats that wrap
    local y0 = 0
    local sy = y0 + 40
    local x = 8
    for _, c in ipairs(STATS) do
      if x + c[3] + c[4] + 4 > W - 8 then x, sy = 8, sy + 20 end
      label(c[2], x, sy, c[3], 16)
      text(c[1], x + c[3] + 4, sy, c[4], 16, true)
      x = x + c[3] + c[4] + 16
    end
    local h0 = sy - y0 + 24
    -- Groups are filled; move this one behind the labels drawn above
    group("Combined", 0, y0, W, h0)
    table.insert(graphics, 1, table.remove(graphics))
    label("Status", 8, y0 + 20, 40, 16)
    layout["Status"] = { Style = "Text", Position = { 52, y0 + 20 }, Size = { W - 60, 16 }, FontSize = 11 }

    -- Control
    local y1 = y0 + h0 + 4
    group("Control", 0, y1, W, 84)
    local r1, r2, r3 = y1 + 20, y1 + 40, y1 + 60
    button("SelectAll", "Select All", 8, r1, 64, 16)
    button("SelectNone", "Clear", 76, r1, 48, 16)
    button("On", ON_LEGEND, 136, r1, 56, 16, { 0, 170, 60 })
    button("Off", OFF_LEGEND, 196, r1, 56, 16, { 210, 40, 40 })
    button("AllOn", "Hold: All On", 264, r1, 76, 16, { 0, 170, 60 })
    button("AllOff", "Hold: All Off", 344, r1, 76, 16, { 210, 40, 40 })
    layout["HoldProgress"] = {
      Style = "Meter", MeterStyle = "Level", ShowTextbox = false, Position = { 428, r1 + 4 }, Size = { W - 436, 8 }
    }
    label("Last action", 8, r2, 64, 16, "Left")
    text("LastAction", 76, r2, 344, 16, true)
    text("AllScopeResult", 428, r2, W - 436, 16, true)
    label(HELP, 8, r3, W - 16, 16, "Left")

    -- Rows
    local y2 = y1 + 84 + 4
    group(ROWS_TITLE, 0, y2, W, 44 + n * 20)
    local stx = 216
    label("Select", 8, y2 + 20, 76, 16, "Center")
    label("On / Off / Power", 108, y2 + 20, 104, 16, "Center")
    for _, c in ipairs(COLS) do
      if not c.metering or metering then
        label(c[2], stx, y2 + 20, c[3], 16, "Center")
        stx = stx + c[3] + 4
      end
    end
    label(STATUS_TITLE, stx, y2 + 20, W - stx - 8, 16, "Center")
    for i = 1, n do
      local y = y2 + 40 + (i - 1) * 20
      button(key("Select", i), ROW_NAME .. " " .. i, 8, y, 76, 16)
      layout[key(LED, i)] = { Style = "Led", Position = { 88, y }, Size = { 16, 16 }, Color = { 0, 220, 0 } }
      button(key("RowOn", i), "On", 108, y, 32, 16, { 0, 170, 60 })
      button(key("RowOff", i), "Off", 142, y, 32, 16, { 210, 40, 40 })
      button(key("RowPower", i), "", 176, y, 36, 16, { 0, 170, 60 })
      local cx = 216
      for _, c in ipairs(COLS) do
        if not c.metering or metering then
          text(key(c[1], i), cx, y, c[3], 16, true)
          cx = cx + c[3] + 4
        end
      end
      layout[key(STATUS_CTL, i)] = { Style = "Text", Position = { cx, y }, Size = { W - cx - 8, 16 }, FontSize = 11 }
    end

  elseif page == "Setup" then
    -- Assignment
    local y0 = 0
    local hAssign = 44 + n * 20
    group(ASSIGN_TITLE, 0, y0, W, hAssign)
    local cx = { num = 8, comp = 32, name = 176, on = 280, off = 364, res = 448 }
    label("Component", cx.comp, y0 + 20, 140, 16, "Center")
    label("Display Name", cx.name, y0 + 20, 100, 16, "Center")
    label(ON_FIELD[2], cx.on, y0 + 20, 80, 16, "Center")
    label(OFF_FIELD[2], cx.off, y0 + 20, 80, 16, "Center")
    label("Resolved", cx.res, y0 + 20, W - cx.res - 8, 16, "Center")
    for i = 1, n do
      local y = y0 + 40 + (i - 1) * 20
      label(tostring(i), cx.num, y, 20, 16, "Center")
      layout[key("ComponentName", i)] = { Style = "ComboBox", Position = { cx.comp, y }, Size = { 140, 16 }, FontSize = 11 }
      text(key(NAME_CTL, i), cx.name, y, 100, 16)
      text(key(ON_FIELD[1], i), cx.on, y, 80, 16)
      text(key(OFF_FIELD[1], i), cx.off, y, 80, 16)
      layout[key("Resolved", i)] = {
        Style = "Text", Position = { cx.res, y }, Size = { W - cx.res - 8, 16 }, FontSize = 11,
        HTextAlign = "Left", IsReadOnly = true
      }
    end

    -- Global settings
    local y1 = y0 + hAssign + 4
    local firstGraphic = #graphics + 1
    local lx, lw, vx = 8, 150, 162
    local hx, hw = vx + 128, W - vx - 136
    local function row(r) return y1 + 20 + (r - 1) * 20 end
    label(SCOPE_LABEL, lx, row(1), lw, 16)
    text("AllScope", vx, row(1), 120, 16)
    label(SCOPE_HINT, hx, row(1), hw, 16, "Left")
    label(DEFAULT_ON[2], lx, row(2), lw, 16)
    text(DEFAULT_ON[1], vx, row(2), 120, 16)
    label(FIELD_HINT, hx, row(2), hw, 16, "Left")
    label(DEFAULT_OFF[2], lx, row(3), lw, 16)
    text(DEFAULT_OFF[1], vx, row(3), 120, 16)
    label(OVERRIDE_HINT, hx, row(3), hw, 16, "Left")
    label("Hold Time (s)", lx, row(4), lw, 16)
    text("HoldTime", vx, row(4), 60, 16)
    if EXTRA_HINT then label(EXTRA_HINT, hx, row(4), hw, 16, "Left") end
    label(STAGGER_LABEL, lx, row(5), lw, 16)
    text("Stagger", vx, row(5), 60, 16)
    label("Poll Interval (s)", lx, row(6), lw, 16)
    text("PollInterval", vx, row(6), 60, 16)
    label("Deselect After On/Off", lx, row(7), lw, 16)
    button("AutoClear", "", vx, row(7), 36, 16)
    local rows = 7
    if METER_SOURCE and metering then
      rows = 8
      label("Meter Source", lx, row(8), lw, 16)
      layout["MeterSource"] = { Style = "ComboBox", Position = { vx, row(8) }, Size = { 120, 16 }, FontSize = 11 }
      label(METER_SOURCE, hx, row(8), hw, 16, "Left")
    end
    -- Groups are filled; move this one behind its labels
    group("Global Settings", 0, y1, W, 24 + rows * 20)
    table.insert(graphics, firstGraphic, table.remove(graphics))
  end

  local prettyNames = {
    Status = "Combined~Status",
    PDUsOnline = "Combined~PDUs Online",
    OutletsOn = "Combined~Outlets On",
    TotalPower = "Combined~Total Power",
    TotalCurrent = "Combined~Total Current",
    TotalEnergy = "Combined~Total Energy",
    AvgVoltage = "Combined~Average Voltage",
    SelectAll = "Control~Select All",
    SelectNone = "Control~Clear Selection",
    On = "Control~On",
    Off = "Control~Off",
    AllOn = "Control~Hold All On",
    AllOff = "Control~Hold All Off",
    HoldProgress = "Control~Hold Progress",
    LastAction = "Control~Last Action",
    AllScopeResult = "Control~Resolved All Scope",
    AllScope = "Global Settings~All On / All Off PDUs",
    DefaultOnOutlets = "Global Settings~Default On Outlets",
    DefaultOffOutlets = "Global Settings~Default Off Outlets",
    HoldTime = "Global Settings~Hold Time",
    Stagger = "Global Settings~PDU Stagger",
    PollInterval = "Global Settings~Poll Interval",
    AutoClear = "Global Settings~Deselect After On/Off",
    MeterSource = "Global Settings~Meter Source"
  }
  local deviceNames = {
    Select = "Select", RowOn = "On", RowOff = "Off", RowPower = "Power On/Off", PduLed = "Online", PduState = "State",
    PduPower = "Power", PduCurrent = "Current", PduEnergy = "Energy",
    PduStatus = "Status", ComponentName = "Setup~Component",
    PduName = "Setup~Display Name", OnOutlets = "Setup~On Outlets",
    OffOutlets = "Setup~Off Outlets", Resolved = "Setup~Resolved Outlets"
  }
  for i = 1, n do
    for name, pretty in pairs(deviceNames) do
      prettyNames[key(name, i)] = "PDUs~PDU " .. i .. "~" .. pretty
    end
  end
  for name, entry in pairs(layout) do
    entry.PrettyName = prettyNames[name]
  end

  return layout, graphics
end

--------------------------------------------------------------------
-- Runtime
--------------------------------------------------------------------
if Controls then
  local N = Properties["PDU Count"].Value
  local DEBUG = Properties["Debug Print"].Value == "Yes"
  local EMULATING = System ~= nil and System.IsEmulating == true
  local METERING = Properties["Metering"].Value == "On"

  local function log(...)
    if DEBUG then print(...) end
  end

  -- Controls with Count = 1 are single objects, otherwise arrays
  local function arr(c)
    if c == nil then return {} end
    if type(c) == "table" and c[1] ~= nil then return c end
    return { c }
  end

  local C = {}
  for _, name in ipairs({ "Select", "RowOn", "RowOff", "RowPower", "PduLed", "PduState", "PduPower", "PduCurrent", "PduEnergy", "PduStatus",
    "ComponentName", "PduName", "OnOutlets", "OffOutlets", "Resolved" }) do
    C[name] = arr(Controls[name])
  end

  local function trim(s)
    return ((s or ""):match("^%s*(.-)%s*$"))
  end

  ------------------------------------------------------------------
  -- Range parsing: "all", "1-9", "1-4, 6-9", "one to nine", "all except 5", "!10", "none"
  ------------------------------------------------------------------
  local NumberWords = {
    one = 1, two = 2, three = 3, four = 4, five = 5, six = 6, seven = 7, eight = 8, nine = 9, ten = 10,
    eleven = 11, twelve = 12, thirteen = 13, fourteen = 14, fifteen = 15, sixteen = 16,
    seventeen = 17, eighteen = 18, nineteen = 19, twenty = 20
  }
  local ExcludeWords = { except = true, ["not"] = true, exclude = true, excluding = true, but = true, without = true }

  -- Returns sorted list of numbers in 1..max, and a list of unrecognised tokens.
  local function parseSet(textIn, max)
    local s = trim(textIn):lower()
    if s == "none" then return {}, {} end
    s = s:gsub("%a+", function(w) return NumberWords[w] and tostring(NumberWords[w]) or w end)
    s = s:gsub("%s+to%s+", "-"):gsub("%s*%.%.%s*", "-"):gsub("%s*%-%s*", "-")
    s = s:gsub("%f[%a]and%f[%A]", ",")

    local inc, exc, bad = {}, {}, {}
    local anyInc, excludeMode = false, false
    for rawTok in s:gmatch("[^,;%s]+") do
      local tok = rawTok
      if ExcludeWords[tok] then
        excludeMode = true
      else
        local neg = false
        if tok:sub(1, 1) == "!" then
          neg = true
          tok = tok:sub(2)
        end
        local target = (neg or excludeMode) and exc or inc
        if tok == "all" or tok == "*" then
          for i = 1, max do inc[i] = true end
          anyInc = true
        else
          local a, b = tok:match("^(%d+)%-(%d+)$")
          if not a then
            a = tok:match("^(%d+)$")
            b = a
          end
          if a then
            a, b = tonumber(a), tonumber(b)
            if a > b then a, b = b, a end
            for i = a, math.min(b, max) do target[i] = true end
            if target == inc then anyInc = true end
          elseif tok ~= "" then
            table.insert(bad, rawTok)
          end
        end
      end
    end
    if not anyInc then
      for i = 1, max do inc[i] = true end
    end
    local list = {}
    for i = 1, max do
      if inc[i] and not exc[i] then table.insert(list, i) end
    end
    return list, bad
  end

  -- {1,2,3,5,7,8} -> "1-3, 5, 7-8"
  local function compact(list)
    local parts, i = {}, 1
    while i <= #list do
      local j = i
      while j < #list and list[j + 1] == list[j] + 1 do j = j + 1 end
      if j > i then
        table.insert(parts, list[i] .. "-" .. list[j])
      else
        table.insert(parts, tostring(list[i]))
      end
      i = j + 1
    end
    if #parts == 0 then return "none" end
    return table.concat(parts, ", ")
  end

  ------------------------------------------------------------------
  -- PDU binding
  ------------------------------------------------------------------
  -- Gude Expert Power Control plugin. Component Type looks like
  -- %PLUGIN%_155aca43-286f-4b5d-8063-a567999c55e3_%FP%_<hash>; the hash changes per version.
  local GudePluginId = "155aca43-286f-4b5d-8063-a567999c55e3"

  local MetricKeys = { "power", "current", "energy", "voltage" }
  local MetricNames = { Power = "power", Current = "current", Energy = "energy", Voltage = "voltage" }
  local SingleCtls = { Status = "status", Disable = "disable", Model = "model", Uptime = "uptime", IPAddress = "ip" }

  local pdus = {}

  local function displayName(i)
    local nm = trim(C.PduName[i] and C.PduName[i].String)
    if nm == "" then return "PDU " .. i end
    return nm
  end

  local function bind(i)
    local p = {
      index = i, outlets = {}, outletNums = {}, online = false, ctl = {},
      meters = {
        Inlet = { power = {}, current = {}, energy = {}, voltage = {} },
        Outlet = { power = {}, current = {}, energy = {}, voltage = {} },
      }
    }
    pdus[i] = p
    p.name = trim(C.ComponentName[i].String)
    if p.name == "" then
      p.reason = "Not assigned"
      p.unassigned = true
      return p
    end
    local ok, ctls = pcall(Component.GetControls, p.name)
    if not ok or type(ctls) ~= "table" or #ctls == 0 then
      p.reason = "Component '" .. p.name .. "' not found (check name / Script Access)"
      return p
    end
    p.comp = Component.New(p.name)

    for _, c in ipairs(ctls) do
      local cname = c.Name or ""
      local src, kind, num = cname:match("^(Outlet)(%a+)%s+(%d+)$")
      if not src then src, kind, num = cname:match("^(Inlet)(%a+)%s+(%d+)$") end
      num = tonumber(num)
      if src == "Outlet" and (kind == "On" or kind == "Off" or kind == "State" or kind == "Name") then
        p.outlets[num] = p.outlets[num] or {}
        p.outlets[num][kind:lower()] = cname
      elseif (src == "Inlet" or src == "Outlet") and MetricNames[kind] then
        table.insert(p.meters[src][MetricNames[kind]], cname)
      elseif SingleCtls[cname] then
        p.ctl[SingleCtls[cname]] = cname
      end
    end

    for num, o in pairs(p.outlets) do
      if o.on or o.off then table.insert(p.outletNums, num) end
    end
    table.sort(p.outletNums)
    for _, src in pairs(p.meters) do
      for _, list in pairs(src) do
        table.sort(list, function(a, b) return tonumber(a:match("%d+$")) < tonumber(b:match("%d+$")) end)
      end
    end
    p.maxOutlet = p.outletNums[#p.outletNums] or 0
    p.online = #p.outletNums > 0
    if not p.online then p.reason = "No OutletOn/OutletOff controls on '" .. p.name .. "'" end
    log(("Bound PDU %d '%s': %d outlets"):format(i, p.name, #p.outletNums))
    return p
  end

  local function bindAll()
    for i = 1, N do bind(i) end
  end

  -- Outlet list for a PDU: "on" or "off"
  local function outletList(i, which)
    local p = pdus[i]
    if not p or not p.online then return {}, {} end
    local own = which == "on" and C.OnOutlets[i] or C.OffOutlets[i]
    local textIn = trim(own and own.String)
    if textIn == "" then
      textIn = which == "on" and Controls.DefaultOnOutlets.String or Controls.DefaultOffOutlets.String
    end
    local list, bad = parseSet(textIn, p.maxOutlet)
    local out = {}
    for _, n in ipairs(list) do
      if p.outlets[n] and p.outlets[n][which] then table.insert(out, n) end
    end
    return out, bad
  end

  local function updateResolved(i)
    local p = pdus[i]
    local r = C.Resolved[i]
    if not r then return end
    if not p or not p.online then
      r.String = p and p.reason or ""
      return
    end
    local onL, badOn = outletList(i, "on")
    local offL, badOff = outletList(i, "off")
    local s = ("%d outlets | On: %s | Off: %s"):format(#p.outletNums, compact(onL), compact(offL))
    if #badOn + #badOff > 0 then
      local bad = {}
      for _, b in ipairs(badOn) do table.insert(bad, b) end
      for _, b in ipairs(badOff) do table.insert(bad, b) end
      s = s .. " | ignored: " .. table.concat(bad, " ")
    end
    r.String = s
  end

  local function updateAllResolved()
    for i = 1, N do updateResolved(i) end
  end

  local function allScope()
    local list, bad = parseSet(Controls.AllScope.String, N)
    local names = {}
    for _, i in ipairs(list) do table.insert(names, i) end
    local s = "All On/Off PDUs: " .. compact(names)
    if #bad > 0 then s = s .. "  (ignored: " .. table.concat(bad, " ") .. ")" end
    Controls.AllScopeResult.String = s
    return list
  end

  ------------------------------------------------------------------
  -- Reading values
  ------------------------------------------------------------------
  local function readCtl(p, cname)
    local ok, ctl = pcall(function() return p.comp[cname] end)
    if ok then return ctl end
  end

  local Prefix = { m = 0.001, k = 1000, K = 1000, M = 1000000 }
  local BaseUnit = { power = "W", current = "A", energy = "Wh", voltage = "V" }

  -- Gude values are strings such as "123.4 W", "0.52A", "12.345 kWh", "230 V".
  -- Returns the value in base units (W, A, Wh, V); nil when empty / non-numeric.
  local function parseMeasure(s, key)
    s = trim(s):gsub(",", ".")
    local num, unit = s:match("^([-+]?%d*%.?%d+)%s*(%a*)")
    num = tonumber(num)
    if not num then return nil end
    local base = BaseUnit[key]
    if unit ~= "" and unit ~= base and unit:sub(-#base) == base then
      num = num * (Prefix[unit:sub(1, #unit - #base)] or 1)
    elseif unit == "" and key == "energy" then
      num = num * 1000 -- unitless energy assumed kWh
    end
    return num
  end

  local function readMeasure(p, cname, key)
    local ctl = readCtl(p, cname)
    if not ctl then return nil end
    local v = parseMeasure(ctl.String or "", key)
    if v == nil and tonumber(ctl.Value) and ctl.String == "" then v = tonumber(ctl.Value) end
    return v
  end

  local function meterSource()
    return Controls.MeterSource.String == "Outlets" and "Outlet" or "Inlet"
  end

  local function fmt(v, unit)
    if v == nil then return "--" end
    local s
    if math.abs(v) >= 100 then s = ("%.0f"):format(v)
    elseif math.abs(v) >= 10 then s = ("%.1f"):format(v)
    else s = ("%.2f"):format(v) end
    return s .. " " .. unit
  end

  local function fmtEnergy(wh)
    if wh == nil then return "--" end
    return fmt(wh / 1000, "kWh")
  end

  -- Per-row toggle shows the commanded state until feedback has had time to catch up
  local pending = {}

  local function update()
    local tot = { power = nil, current = nil, energy = nil }
    local vSum, vCount = 0, 0
    local onlineCount, assignedCount, outletsOn, outletsTotal = 0, 0, 0, 0
    local issues, healthy = {}, 0

    for i = 1, N do
      local p = pdus[i]
      if p and not p.online and not p.unassigned then p = bind(i) end
      local st = C.PduStatus[i]

      if not p or not p.online then
        C.PduLed[i].Boolean = false
        C.RowPower[i].Boolean = false
        C.PduState[i].String = p and p.unassigned and "" or "Offline"
        if METERING then
          C.PduPower[i].String, C.PduCurrent[i].String, C.PduEnergy[i].String = "", "", ""
        end
        if p and p.unassigned then
          st.Value = 3
          st.String = "Not assigned"
        else
          assignedCount = assignedCount + 1
          st.Value = 4
          st.String = p and p.reason or "Missing"
          table.insert(issues, displayName(i) .. ": " .. (p and p.reason or "missing"))
        end
      else
        assignedCount = assignedCount + 1
        onlineCount = onlineCount + 1

        -- Outlet state
        local onSet, offSet = {}, {}
        for _, n in ipairs(outletList(i, "on")) do onSet[n] = true end
        for _, n in ipairs(outletList(i, "off")) do offSet[n] = true end
        local allOn, allOff, anyOnSet, anyOffSet = true, true, false, false
        local count, total = 0, 0
        for _, n in ipairs(p.outletNums) do
          local o = p.outlets[n]
          if o.state then
            local ctl = readCtl(p, o.state)
            local isOn = ctl and ctl.Boolean or false
            total = total + 1
            if isOn then count = count + 1 end
            if onSet[n] then anyOnSet = true; if not isOn then allOn = false end end
            if offSet[n] then anyOffSet = true; if isOn then allOff = false end end
          end
        end
        outletsOn, outletsTotal = outletsOn + count, outletsTotal + total
        local stateText
        if total == 0 then stateText = "No feedback"
        elseif allOn and anyOnSet and count > 0 then stateText = "On"
        elseif allOff and anyOffSet then stateText = "Off"
        else stateText = "Partial" end
        if total > 0 then stateText = ("%s (%d/%d)"):format(stateText, count, total) end
        C.PduState[i].String = stateText
        C.PduLed[i].Boolean = count > 0 and not (allOff and anyOffSet)
        if not pending[i] or Timer.Now() >= pending[i] then
          pending[i] = nil
          C.RowPower[i].Boolean = C.PduLed[i].Boolean
        end

        -- Metering
        -- Power/current/energy are summed; voltage is averaged over live (non-zero) readings,
        -- so an unused second inlet doesn't drag the average down.
        if METERING then
          local vals = {}
          local src = p.meters[meterSource()]
          for _, key in ipairs(MetricKeys) do
            local sum, n = 0, 0
            for _, cname in ipairs(src[key]) do
              local v = readMeasure(p, cname, key)
              if v and not (key == "voltage" and v <= 0) then sum = sum + v; n = n + 1 end
            end
            if n > 0 then vals[key] = key == "voltage" and sum / n or sum end
          end
          C.PduPower[i].String = fmt(vals.power, "W")
          C.PduCurrent[i].String = fmt(vals.current, "A")
          C.PduEnergy[i].String = fmtEnergy(vals.energy)
          for _, k in ipairs({ "power", "current", "energy" }) do
            if vals[k] then tot[k] = (tot[k] or 0) + vals[k] end
          end
          if vals.voltage then vSum, vCount = vSum + vals.voltage, vCount + 1 end
        end

        -- Status reported by the PDU plugin itself
        local code, msg = 0, "OK"
        if p.ctl.status then
          local sc = readCtl(p, p.ctl.status)
          if sc then
            code = tonumber(sc.Value) or 0
            msg = sc.String ~= "" and sc.String or msg
          end
        end
        local dis = p.ctl.disable and readCtl(p, p.ctl.disable)
        if dis and dis.Boolean then
          code, msg = 3, "Disabled"
        end
        -- In emulation the device plugins are disabled / not present; don't report that as a fault
        if EMULATING then code, msg = 0, "OK" end
        st.Value = code
        st.String = msg
        if code == 0 then
          healthy = healthy + 1
        else
          table.insert(issues, displayName(i) .. ": " .. msg)
        end
      end
    end

    Controls.PDUsOnline.String = ("%d / %d"):format(onlineCount, assignedCount)
    Controls.OutletsOn.String = ("%d / %d"):format(outletsOn, outletsTotal)
    if METERING then
      Controls.TotalPower.String = fmt(tot.power, "W")
      Controls.TotalCurrent.String = fmt(tot.current, "A")
      Controls.TotalEnergy.String = fmtEnergy(tot.energy)
      Controls.AvgVoltage.String = vCount > 0 and fmt(vSum / vCount, "V") or "--"
    end

    local code
    if assignedCount == 0 then
      code = 3
      Controls.Status.Value = code
      Controls.Status.String = "No PDUs assigned (see Setup page)"
    else
      if #issues == 0 then code = 0
      elseif healthy > 0 then code = 1
      else code = 2 end
      Controls.Status.Value = code
      if code == 0 then
        Controls.Status.String = ("All %d PDUs OK"):format(healthy) .. (EMULATING and " (emulating)" or "")
      else
        Controls.Status.String = ("%d/%d OK - %s"):format(healthy, assignedCount, table.concat(issues, "; "))
      end
    end
  end

  ------------------------------------------------------------------
  -- Switching
  ------------------------------------------------------------------
  local function switchPdu(i, on)
    local p = pdus[i]
    if not p or not p.online then return 0 end
    local which = on and "on" or "off"
    local list = outletList(i, which)
    for _, n in ipairs(list) do
      local cname = p.outlets[n][which]
      local ctl = readCtl(p, cname)
      if ctl then ctl:Trigger() end
    end
    log(("%s %s outlets %s"):format(displayName(i), which, compact(list)))
    return #list
  end

  local refreshTimer = Timer.New()
  refreshTimer.EventHandler = function()
    refreshTimer:Stop()
    update()
  end

  local function run(indices, on, source)
    local stagger = math.max(Controls.Stagger.Value, 0)
    local names, delay = {}, 0
    for k, i in ipairs(indices) do
      local p = pdus[i]
      if p and p.online then
        table.insert(names, displayName(i))
        if delay <= 0 then
          switchPdu(i, on)
        else
          Timer.CallAfter(function() switchPdu(i, on) end, delay)
        end
        delay = delay + stagger
        C.PduState[i].String = on and "Switching on..." or "Switching off..."
        C.RowPower[i].Boolean = on
        pending[i] = Timer.Now() + delay + 5
      end
    end
    local summary = #names > 0 and table.concat(names, ", ") or "no online PDUs"
    Controls.LastAction.String = ("%s %s: %s"):format(source, on and "ON" or "OFF", summary)
    refreshTimer:Stop()
    refreshTimer:Start(delay + 1.5)
  end

  local function selectedIndices()
    local list = {}
    for i = 1, N do
      if C.Select[i].Boolean then table.insert(list, i) end
    end
    return list
  end

  local function clearSelection()
    for i = 1, N do C.Select[i].Boolean = false end
  end

  local function runSelected(on)
    local list = selectedIndices()
    if #list == 0 then
      Controls.LastAction.String = "Nothing selected"
      return
    end
    run(list, on, "Selected")
    if Controls.AutoClear.Boolean then clearSelection() end
  end

  Controls.On.EventHandler = function() runSelected(true) end
  Controls.Off.EventHandler = function() runSelected(false) end
  Controls.SelectAll.EventHandler = function()
    for i = 1, N do C.Select[i].Boolean = pdus[i] ~= nil and pdus[i].online end
  end
  Controls.SelectNone.EventHandler = clearSelection

  for i = 1, N do
    C.RowOn[i].EventHandler = function() run({ i }, true, "Row") end
    C.RowOff[i].EventHandler = function() run({ i }, false, "Row") end
    C.RowPower[i].EventHandler = function(ctl)
      local d = pdus[i]
      if d and d.online then
        run({ i }, ctl.Boolean, "Row")
      else
        ctl.Boolean = false
        Controls.LastAction.String = displayName(i) .. " is offline"
      end
    end
  end

  ------------------------------------------------------------------
  -- Press and hold All On / All Off
  ------------------------------------------------------------------
  local hold = { timer = Timer.New(), which = nil, start = 0, fired = false }

  local function stopHold()
    hold.timer:Stop()
    hold.which = nil
    Controls.HoldProgress.Position = 0
  end

  hold.timer.EventHandler = function()
    if not hold.which then return stopHold() end
    local ht = math.max(Controls.HoldTime.Value, 0)
    local elapsed = Timer.Now() - hold.start
    Controls.HoldProgress.Position = ht > 0 and math.min(elapsed / ht, 1) or 1
    if not hold.fired and elapsed >= ht then
      hold.fired = true
      run(allScope(), hold.which == "on", "All")
    end
  end

  local function holdHandler(which)
    return function(ctl)
      if ctl.Boolean then
        hold.which = which
        hold.start = Timer.Now()
        hold.fired = false
        Controls.HoldProgress.Position = 0
        hold.timer:Start(0.05)
      elseif hold.which == which then
        stopHold()
      end
    end
  end

  Controls.AllOn.EventHandler = holdHandler("on")
  Controls.AllOff.EventHandler = holdHandler("off")

  ------------------------------------------------------------------
  -- Setup handlers
  ------------------------------------------------------------------
  local function findPduComponents()
    local names = {}
    local ok, comps = pcall(Component.GetComponents)
    if not ok or type(comps) ~= "table" then return names end
    for _, c in ipairs(comps) do
      if tostring(c.Type or ""):find(GudePluginId, 1, true) then
        table.insert(names, c.Name)
      end
    end
    table.sort(names)
    return names
  end

  local function refreshChoices()
    local names = findPduComponents()
    local choices = { "" }
    for _, n in ipairs(names) do table.insert(choices, n) end
    for i = 1, N do C.ComponentName[i].Choices = choices end
    log(("Found %d Gude PDU components"):format(#names))
  end

  local function refreshLegend(i)
    C.Select[i].Legend = displayName(i)
  end

  local poll = Timer.New()
  poll.EventHandler = update

  local function startPoll()
    poll:Stop()
    poll:Start(math.max(Controls.PollInterval.Value, 1))
  end

  local function rebindAll()
    bindAll()
    updateAllResolved()
    for i = 1, N do refreshLegend(i) end
    update()
  end

  for i = 1, N do
    C.ComponentName[i].EventHandler = function()
      bind(i)
      updateResolved(i)
      update()
    end
    C.PduName[i].EventHandler = function()
      refreshLegend(i)
    end
    C.OnOutlets[i].EventHandler = function()
      updateResolved(i)
      update()
    end
    C.OffOutlets[i].EventHandler = C.OnOutlets[i].EventHandler
  end

  Controls.DefaultOnOutlets.EventHandler = function()
    updateAllResolved()
    update()
  end
  Controls.DefaultOffOutlets.EventHandler = Controls.DefaultOnOutlets.EventHandler
  Controls.AllScope.EventHandler = function() allScope() end
  Controls.PollInterval.EventHandler = startPoll
  if METERING then
    Controls.MeterSource.Choices = { "Inlets", "Outlets" }
    if Controls.MeterSource.String ~= "Outlets" then Controls.MeterSource.String = "Inlets" end
    Controls.MeterSource.EventHandler = update
  end

  ------------------------------------------------------------------
  -- Init
  ------------------------------------------------------------------
  refreshChoices()
  rebindAll()
  allScope()
  startPoll()
end
